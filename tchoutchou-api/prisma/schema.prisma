generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model FavoriteStation {
  id        String @id @default(uuid())
  userId    Int
  stationId String
  stationName String
  createdAt DateTime @default(now())

  @@unique([userId, stationId])
  @@index([userId])
}